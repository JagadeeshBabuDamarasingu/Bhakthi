  "verses": [
    { "index": 1,  "sanskrit": "ॐ गणेशाय नमः",         "transliteration": "Om Gaṇeśāya Namaḥ",         "english": "Salutations to the Lord of Ganas",              "audioUrl": "" },
    { "index": 2,  "sanskrit": "ॐ एकदन्ताय नमः",        "transliteration": "Om Ekadantāya Namaḥ",        "english": "Salutations to the single-tusked one",          "audioUrl": "" },
