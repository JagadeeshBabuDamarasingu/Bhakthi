    { "index": 39, "sanskrit": "ॐ विश्वेश्वराय नमः",      "transliteration": "Om Viśveśvarāya Namaḥ",      "english": "Salutations to the lord of the universe",      "audioUrl": "" },
    { "index": 40, "sanskrit": "ॐ सर्वेश्वराय नमः",       "transliteration": "Om Sarveśvarāya Namaḥ",      "english": "Salutations to the lord of all",               "audioUrl": "" },

